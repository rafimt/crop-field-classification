# Copy this file to `.env` and fill in your Sentinel Hub OAuth credentials.
# Create an OAuth client in the Sentinel Hub / Copernicus Data Space dashboard.
# NEVER commit the real .env file (it is gitignored).

SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Defaults below target the Copernicus Data Space Ecosystem (free trial).
# For the classic sentinel-hub.com account, use:
#   SH_BASE_URL=https://services.sentinel-hub.com
#   SH_TOKEN_URL=https://services.sentinel-hub.com/oauth/token
SH_BASE_URL=https://sh.dataspace.copernicus.eu
SH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
